<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Liquid Orb</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html,body{
    width:100%;
    height:100%;
    overflow:hidden;
}

body{
    background:#02030a;

    display:flex;
    align-items:center;
    justify-content:center;

    font-family:
        system-ui,
        sans-serif;

    cursor:none;
}


/* =====================================================
   CANVAS
===================================================== */

canvas{
    position:fixed;

    inset:0;

    width:100%;
    height:100%;
}


/* =====================================================
   CENTER TEXT
===================================================== */

.info{
    position:fixed;

    left:50%;
    bottom:35px;

    transform:
        translateX(-50%);

    color:
        rgba(255,255,255,.35);

    font-size:11px;

    letter-spacing:3px;

    text-transform:uppercase;

    pointer-events:none;

    user-select:none;
}


/* =====================================================
   CURSOR
===================================================== */

.cursor{

    position:fixed;

    width:12px;
    height:12px;

    border-radius:50%;

    border:1px solid
        rgba(255,255,255,.8);

    transform:
        translate(-50%,-50%);

    pointer-events:none;

    z-index:10;

    mix-blend-mode:difference;

}

</style>
</head>

<body>


<canvas id="canvas"></canvas>

<div class="cursor"></div>

<div class="info">
    Move your mouse
</div>


<script>

/* =====================================================
   SETUP
===================================================== */

const canvas =
    document.getElementById("canvas");

const ctx =
    canvas.getContext("2d");


let W = 0;
let H = 0;
let DPR = 1;


function resize(){

    DPR =
        Math.min(
            window.devicePixelRatio || 1,
            2
        );


    W =
        window.innerWidth;

    H =
        window.innerHeight;


    canvas.width =
        W * DPR;

    canvas.height =
        H * DPR;


    canvas.style.width =
        W + "px";

    canvas.style.height =
        H + "px";


    ctx.setTransform(
        DPR,
        0,
        0,
        DPR,
        0,
        0
    );

}


resize();

window.addEventListener(
    "resize",
    resize
);


/* =====================================================
   MOUSE
===================================================== */

const mouse = {

    x:W/2,
    y:H/2,

    targetX:W/2,
    targetY:H/2

};


window.addEventListener(
    "pointermove",
    e => {

        mouse.targetX =
            e.clientX;

        mouse.targetY =
            e.clientY;

    }
);


/* =====================================================
   CURSOR
===================================================== */

const cursor =
    document.querySelector(
        ".cursor"
    );


function updateCursor(){

    cursor.style.left =
        mouse.targetX + "px";

    cursor.style.top =
        mouse.targetY + "px";

}


/* =====================================================
   ORB PARTICLES
===================================================== */

const particles = [];

const PARTICLE_COUNT = 90;


for(
    let i=0;
    i<PARTICLE_COUNT;
    i++
){

    const angle =
        Math.random() *
        Math.PI * 2;


    particles.push({

        angle,

        distance:
            100 +
            Math.random()*100,

        size:
            Math.random()*2.2+.5,

        speed:
            (.15 +
            Math.random()*.25) *
            (
                Math.random()>.5
                ? 1
                : -1
            ),

        phase:
            Math.random()*Math.PI*2,

        alpha:
            Math.random()*.7+.2

    });

}


/* =====================================================
   RIPPLE SYSTEM
===================================================== */

const ripples = [];


function createRipple(){

    ripples.push({

        radius:40,

        alpha:.7,

        speed:
            2 +
            Math.random()*1.5,

        rotation:
            Math.random()*Math.PI*2

    });


    /*
       Không để quá nhiều ripple.
    */

    if(ripples.length > 5){

        ripples.shift();

    }

}


/*
   Tự sinh ripple.
*/

setInterval(
    createRipple,
    900
);


/* =====================================================
   DRAW GLOW
===================================================== */

function glowCircle(
    x,
    y,
    radius,
    color,
    alpha
){

    const gradient =
        ctx.createRadialGradient(
            x,
            y,
            radius*.05,
            x,
            y,
            radius
        );


    gradient.addColorStop(
        0,
        color.replace(
            ")",
            `,${alpha})`
        )
    );


    gradient.addColorStop(
        1,
        color.replace(
            ")",
            ",0)"
        )
    );


    ctx.fillStyle =
        gradient;

    ctx.beginPath();

    ctx.arc(
        x,
        y,
        radius,
        0,
        Math.PI*2
    );

    ctx.fill();

}


/* =====================================================
   LIQUID ORB
===================================================== */

function drawOrb(
    cx,
    cy,
    time
){

    /*
       Pulse chính.

       Không scale DOM,
       chỉ thay đổi bán kính.
    */

    const pulse =
        Math.sin(time*.003);


    const pulse2 =
        Math.sin(time*.005+.8);


    const baseRadius =
        115 +
        pulse*14;


    /*
       Glow phía sau.
    */

    const glow =
        ctx.createRadialGradient(
            cx,
            cy,
            10,
            cx,
            cy,
            230
        );


    glow.addColorStop(
        0,
        "rgba(80,130,255,.35)"
    );

    glow.addColorStop(
        .35,
        "rgba(120,70,255,.15)"
    );

    glow.addColorStop(
        1,
        "rgba(0,0,0,0)"
    );


    ctx.fillStyle =
        glow;

    ctx.beginPath();

    ctx.arc(
        cx,
        cy,
        230,
        0,
        Math.PI*2
    );

    ctx.fill();


    /*
       Liquid shape.
    */

    ctx.beginPath();


    const points = 90;


    for(
        let i=0;
        i<=points;
        i++
    ){

        const angle =
            i/points *
            Math.PI*2;


        /*
           Nhiều sóng nhỏ
           làm méo hình cầu.
        */

        const wave1 =
            Math.sin(
                angle*3 +
                time*.002
            ) * 8;


        const wave2 =
            Math.sin(
                angle*7 -
                time*.003
            ) * 5;


        const wave3 =
            Math.sin(
                angle*11 +
                time*.0015
            ) * 3;


        const radius =
            baseRadius +
            wave1 +
            wave2 +
            wave3;


        const x =
            cx +
            Math.cos(angle) *
            radius;


        const y =
            cy +
            Math.sin(angle) *
            radius;


        if(i===0){

            ctx.moveTo(
                x,
                y
            );

        }
        else{

            ctx.lineTo(
                x,
                y
            );

        }

    }


    ctx.closePath();


    /*
       Gradient bên trong.
    */

    const orbGradient =
        ctx.createRadialGradient(
            cx-35,
            cy-45,
            5,
            cx,
            cy,
            baseRadius*1.3
        );


    orbGradient.addColorStop(
        0,
        "#dbeafe"
    );

    orbGradient.addColorStop(
        .15,
        "#60a5fa"
    );

    orbGradient.addColorStop(
        .45,
        "#6366f1"
    );

    orbGradient.addColorStop(
        .75,
        "#7c3aed"
    );

    orbGradient.addColorStop(
        1,
        "#17052d"
    );


    ctx.fillStyle =
        orbGradient;

    ctx.fill();


    /*
       Viền sáng.
    */

    ctx.strokeStyle =
        "rgba(160,190,255,.8)";

    ctx.lineWidth = 1.2;

    ctx.shadowColor =
        "#6366f1";

    ctx.shadowBlur = 20;

    ctx.stroke();

    ctx.shadowBlur = 0;


    /*
       Highlight.
    */

    const highlight =
        ctx.createRadialGradient(
            cx-40,
            cy-55,
            0,
            cx-40,
            cy-55,
            65
        );


    highlight.addColorStop(
        0,
        "rgba(255,255,255,.5)"
    );

    highlight.addColorStop(
        1,
        "rgba(255,255,255,0)"
    );


    ctx.fillStyle =
        highlight;

    ctx.beginPath();

    ctx.arc(
        cx-30,
        cy-40,
        70,
        0,
        Math.PI*2
    );

    ctx.fill();


    /*
       Một điểm sáng bên trong.
    */

    const innerX =
        cx +
        Math.cos(
            time*.001
        ) * 45;


    const innerY =
        cy +
        Math.sin(
            time*.001
        ) * 30;


    ctx.beginPath();

    ctx.arc(
        innerX,
        innerY,
        5 +
        pulse2*2,
        0,
        Math.PI*2
    );


    ctx.fillStyle =
        "rgba(255,255,255,.8)";

    ctx.shadowColor =
        "#fff";

    ctx.shadowBlur = 20;

    ctx.fill();

    ctx.shadowBlur = 0;

}


/* =====================================================
   ORBIT PARTICLES
===================================================== */

function drawParticles(
    cx,
    cy,
    time
){

    for(
        const p of particles
    ){

        p.angle +=
            p.speed*.008;


        const wave =
            Math.sin(
                time*.002 +
                p.phase
            );


        const distance =
            p.distance +
            wave*12;


        const x =
            cx +
            Math.cos(
                p.angle
            ) *
            distance;


        const y =
            cy +
            Math.sin(
                p.angle
            ) *
            distance;


        ctx.beginPath();

        ctx.arc(
            x,
            y,
            p.size,
            0,
            Math.PI*2
        );


        ctx.fillStyle =
            `rgba(
                160,
                190,
                255,
                ${p.alpha}
            )`;


        ctx.fill();

    }

}


/* =====================================================
   RIPPLE
===================================================== */

function drawRipples(
    cx,
    cy
){

    for(
        let i=
            ripples.length-1;
        i>=0;
        i--
    ){

        const r =
            ripples[i];


        r.radius +=
            r.speed;


        r.alpha -=
            .008;


        ctx.beginPath();

        /*
           Ripple không hoàn toàn tròn.
        */

        ctx.ellipse(
            cx,
            cy,
            r.radius,
            r.radius*.35,
            r.rotation,
            0,
            Math.PI*2
        );


        ctx.strokeStyle =
            `rgba(
                96,
                165,
                250,
                ${r.alpha}
            )`;


        ctx.lineWidth = 1;

        ctx.shadowColor =
            "#6366f1";

        ctx.shadowBlur = 12;

        ctx.stroke();

        ctx.shadowBlur = 0;


        if(
            r.alpha <= 0
        ){

            ripples.splice(
                i,
                1
            );

        }

    }

}


/* =====================================================
   MAIN LOOP
===================================================== */

function animate(time){

    ctx.clearRect(
        0,
        0,
        W,
        H
    );


    /*
       Background gradient.
    */

    const background =
        ctx.createRadialGradient(
            W/2,
            H/2,
            0,
            W/2,
            H/2,
            Math.max(W,H)*.7
        );


    background.addColorStop(
        0,
        "#0b1230"
    );


    background.addColorStop(
        .5,
        "#050817"
    );


    background.addColorStop(
        1,
        "#02030a"
    );


    ctx.fillStyle =
        background;


    ctx.fillRect(
        0,
        0,
        W,
        H
    );


    /*
       Mouse interpolation.

       Orb không nhảy theo chuột,
       mà trôi theo.
    */

    mouse.x +=
        (mouse.targetX-mouse.x)
        *.025;


    mouse.y +=
        (mouse.targetY-mouse.y)
        *.025;


    /*
       Orb hơi lệch theo chuột.
    */

    const cx =
        W/2 +
        (mouse.x-W/2)*.08;


    const cy =
        H/2 +
        (mouse.y-H/2)*.08;


    drawParticles(
        cx,
        cy,
        time
    );


    drawRipples(
        cx,
        cy
    );


    drawOrb(
        cx,
        cy,
        time
    );


    updateCursor();


    requestAnimationFrame(
        animate
    );

}


requestAnimationFrame(
    animate
);


/* =====================================================
   CLICK = RIPPLE
===================================================== */

window.addEventListener(
    "pointerdown",
    () => {

        /*
           Tạo ripple mạnh hơn
           khi click.
        */

        for(
            let i=0;
            i<2;
            i++
        ){

            createRipple();

        }

    }
);

</script>

</body>
</html>
